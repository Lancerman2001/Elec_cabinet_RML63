  <gazebo reference="camera_sensor_link">
    <sensor name="d435_rgbd_sensor" type="depth">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>0.9666</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.0</stddev>
        </noise>
        <depth_camera>
          <output>depth</output>
        </depth_camera>
      </camera>
      <plugin name="d435_ros2_camera" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/camera</namespace>
          <remapping>__ns:=/camera</remapping>
          <remapping>camera/image_raw:=color/image_raw</remapping>
          <remapping>camera/camera_info:=color/camera_info</remapping>
          <remapping>camera/depth/image_raw:=depth/image_rect_raw</remapping>
          <remapping>camera/depth/camera_info:=depth/camera_info</remapping>
          <remapping>camera/points:=depth/points</remapping>
        </ros>
        <camera_name>camera</camera_name>
        <frame_name>arm/camera_depth_optical_frame</frame_name>
        <min_depth>0.1</min_depth>
        <max_depth>10.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>
