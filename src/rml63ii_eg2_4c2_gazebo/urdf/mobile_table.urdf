<?xml version="1.0"?>
<!--
  文件功能：定义供 Gazebo Classic 复用的 600 x 400 mm 非锚定移动工作台。

  工作台坐标系位于台面中心向地面的投影处，因此台面上表面正好为
  z=0.700 m。本文件是可复用的非锚定组件；prepare_gazebo_urdf.py 会在
  组合模型中安装机械臂，并且仅在锁定版本中添加世界固定关节。

  质量和惯性是仿真近似值，不代表真实小车的测量结果。
-->
<robot name="rml63ii_mobile_table">
  <material name="table_top_light">
    <color rgba="0.72 0.74 0.78 1"/>
  </material>
  <material name="table_frame_gray">
    <color rgba="0.34 0.37 0.40 1"/>
  </material>
  <material name="caster_dark">
    <color rgba="0.12 0.13 0.15 1"/>
  </material>
  <material name="wheel_red">
    <color rgba="0.65 0.06 0.05 1"/>
  </material>

  <!-- 根坐标系：台面中心投影到地面的位置。保持该根链接无质量，以便
       robot_state_publisher/KDL 接受它作为根链接。 -->
  <link name="table_base_link"/>

  <link name="table_body_link">
    <inertial>
      <origin xyz="0 0 0.32" rpy="0 0 0"/>
      <!-- 低位配重使小车成为较重且不头重脚轻的底座。车轮/脚轮仍保留其真实
           小部件质量。 -->
      <mass value="240.0"/>
      <inertia ixx="13.000" ixy="0" ixz="0"
               iyy="17.000" iyz="0" izz="10.400"/>
    </inertial>

    <visual name="tabletop_visual">
      <origin xyz="0 0 0.685" rpy="0 0 0"/>
      <geometry><box size="0.600 0.400 0.030"/></geometry>
      <material name="table_top_light"/>
    </visual>
    <collision name="tabletop_collision">
      <origin xyz="0 0 0.685" rpy="0 0 0"/>
      <geometry><box size="0.600 0.400 0.030"/></geometry>
    </collision>

    <visual name="front_left_leg_visual">
      <origin xyz="0.255 0.155 0.395" rpy="0 0 0"/>
      <geometry><box size="0.030 0.030 0.550"/></geometry>
      <material name="table_frame_gray"/>
    </visual>
    <collision name="front_left_leg_collision">
      <origin xyz="0.255 0.155 0.395" rpy="0 0 0"/>
      <geometry><box size="0.030 0.030 0.550"/></geometry>
    </collision>

    <visual name="front_right_leg_visual">
      <origin xyz="0.255 -0.155 0.395" rpy="0 0 0"/>
      <geometry><box size="0.030 0.030 0.550"/></geometry>
      <material name="table_frame_gray"/>
    </visual>
    <collision name="front_right_leg_collision">
      <origin xyz="0.255 -0.155 0.395" rpy="0 0 0"/>
      <geometry><box size="0.030 0.030 0.550"/></geometry>
    </collision>

    <visual name="rear_left_leg_visual">
      <origin xyz="-0.255 0.155 0.395" rpy="0 0 0"/>
      <geometry><box size="0.030 0.030 0.550"/></geometry>
      <material name="table_frame_gray"/>
    </visual>
    <collision name="rear_left_leg_collision">
      <origin xyz="-0.255 0.155 0.395" rpy="0 0 0"/>
      <geometry><box size="0.030 0.030 0.550"/></geometry>
    </collision>

    <visual name="rear_right_leg_visual">
      <origin xyz="-0.255 -0.155 0.395" rpy="0 0 0"/>
      <geometry><box size="0.030 0.030 0.550"/></geometry>
      <material name="table_frame_gray"/>
    </visual>
    <collision name="rear_right_leg_collision">
      <origin xyz="-0.255 -0.155 0.395" rpy="0 0 0"/>
      <geometry><box size="0.030 0.030 0.550"/></geometry>
    </collision>
  </link>

  <joint name="table_body_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="table_base_link"/>
    <child link="table_body_link"/>
  </joint>

  <!-- 每个脚轮都有竖直旋转轴，轮子位于旋转轴后方 30 mm。 -->
  <joint name="front_left_caster_swivel_joint" type="continuous">
    <origin xyz="0.255 0.155 0.110" rpy="0 0 0"/>
    <parent link="table_body_link"/>
    <child link="front_left_caster_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="2.0" velocity="10.0"/>
    <dynamics damping="0.50" friction="0.50"/>
  </joint>
  <link name="front_left_caster_link">
    <inertial>
      <origin xyz="0.020 0 -0.030" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.00010" ixy="0" ixz="0"
               iyy="0.00015" iyz="0" izz="0.00010"/>
    </inertial>
    <visual name="front_left_caster_visual">
      <origin xyz="0.020 0 -0.030" rpy="0 0 0"/>
      <geometry><box size="0.070 0.040 0.060"/></geometry>
      <material name="caster_dark"/>
    </visual>
    <collision name="front_left_caster_collision">
      <origin xyz="0.020 0 -0.030" rpy="0 0 0"/>
      <geometry><box size="0.070 0.040 0.060"/></geometry>
    </collision>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <origin xyz="0.030 0 -0.060" rpy="0 0 0"/>
    <parent link="front_left_caster_link"/>
    <child link="front_left_wheel_link"/>
    <axis xyz="0 1 0"/>
    <limit effort="5.0" velocity="20.0"/>
    <dynamics damping="0.20" friction="0.20"/>
  </joint>
  <link name="front_left_wheel_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.000203125" ixy="0" ixz="0"
               iyy="0.000375" iyz="0" izz="0.000203125"/>
    </inertial>
    <visual name="front_left_wheel_visual">
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.050" length="0.025"/></geometry>
      <material name="wheel_red"/>
    </visual>
    <collision name="front_left_wheel_collision">
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.050" length="0.025"/></geometry>
    </collision>
  </link>

  <joint name="front_right_caster_swivel_joint" type="continuous">
    <origin xyz="0.255 -0.155 0.110" rpy="0 0 0"/>
    <parent link="table_body_link"/>
    <child link="front_right_caster_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="2.0" velocity="10.0"/>
    <dynamics damping="0.50" friction="0.50"/>
  </joint>
  <link name="front_right_caster_link">
    <inertial>
      <origin xyz="0.020 0 -0.030" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.00010" ixy="0" ixz="0"
               iyy="0.00015" iyz="0" izz="0.00010"/>
    </inertial>
    <visual name="front_right_caster_visual">
      <origin xyz="0.020 0 -0.030" rpy="0 0 0"/>
      <geometry><box size="0.070 0.040 0.060"/></geometry>
      <material name="caster_dark"/>
    </visual>
    <collision name="front_right_caster_collision">
      <origin xyz="0.020 0 -0.030" rpy="0 0 0"/>
      <geometry><box size="0.070 0.040 0.060"/></geometry>
    </collision>
  </link>
  <joint name="front_right_wheel_joint" type="continuous">
    <origin xyz="0.030 0 -0.060" rpy="0 0 0"/>
    <parent link="front_right_caster_link"/>
    <child link="front_right_wheel_link"/>
    <axis xyz="0 1 0"/>
    <limit effort="5.0" velocity="20.0"/>
    <dynamics damping="0.20" friction="0.20"/>
  </joint>
  <link name="front_right_wheel_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.000203125" ixy="0" ixz="0"
               iyy="0.000375" iyz="0" izz="0.000203125"/>
    </inertial>
    <visual name="front_right_wheel_visual">
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.050" length="0.025"/></geometry>
      <material name="wheel_red"/>
    </visual>
    <collision name="front_right_wheel_collision">
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.050" length="0.025"/></geometry>
    </collision>
  </link>

  <joint name="rear_left_caster_swivel_joint" type="continuous">
    <origin xyz="-0.255 0.155 0.110" rpy="0 0 0"/>
    <parent link="table_body_link"/>
    <child link="rear_left_caster_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="2.0" velocity="10.0"/>
    <dynamics damping="0.50" friction="0.50"/>
  </joint>
  <link name="rear_left_caster_link">
    <inertial>
      <origin xyz="0.020 0 -0.030" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.00010" ixy="0" ixz="0"
               iyy="0.00015" iyz="0" izz="0.00010"/>
    </inertial>
    <visual name="rear_left_caster_visual">
      <origin xyz="0.020 0 -0.030" rpy="0 0 0"/>
      <geometry><box size="0.070 0.040 0.060"/></geometry>
      <material name="caster_dark"/>
    </visual>
    <collision name="rear_left_caster_collision">
      <origin xyz="0.020 0 -0.030" rpy="0 0 0"/>
      <geometry><box size="0.070 0.040 0.060"/></geometry>
    </collision>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <origin xyz="0.030 0 -0.060" rpy="0 0 0"/>
    <parent link="rear_left_caster_link"/>
    <child link="rear_left_wheel_link"/>
    <axis xyz="0 1 0"/>
    <limit effort="5.0" velocity="20.0"/>
    <dynamics damping="0.20" friction="0.20"/>
  </joint>
  <link name="rear_left_wheel_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.000203125" ixy="0" ixz="0"
               iyy="0.000375" iyz="0" izz="0.000203125"/>
    </inertial>
    <visual name="rear_left_wheel_visual">
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.050" length="0.025"/></geometry>
      <material name="wheel_red"/>
    </visual>
    <collision name="rear_left_wheel_collision">
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.050" length="0.025"/></geometry>
    </collision>
  </link>

  <joint name="rear_right_caster_swivel_joint" type="continuous">
    <origin xyz="-0.255 -0.155 0.110" rpy="0 0 0"/>
    <parent link="table_body_link"/>
    <child link="rear_right_caster_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="2.0" velocity="10.0"/>
    <dynamics damping="0.50" friction="0.50"/>
  </joint>
  <link name="rear_right_caster_link">
    <inertial>
      <origin xyz="0.020 0 -0.030" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.00010" ixy="0" ixz="0"
               iyy="0.00015" iyz="0" izz="0.00010"/>
    </inertial>
    <visual name="rear_right_caster_visual">
      <origin xyz="0.020 0 -0.030" rpy="0 0 0"/>
      <geometry><box size="0.070 0.040 0.060"/></geometry>
      <material name="caster_dark"/>
    </visual>
    <collision name="rear_right_caster_collision">
      <origin xyz="0.020 0 -0.030" rpy="0 0 0"/>
      <geometry><box size="0.070 0.040 0.060"/></geometry>
    </collision>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <origin xyz="0.030 0 -0.060" rpy="0 0 0"/>
    <parent link="rear_right_caster_link"/>
    <child link="rear_right_wheel_link"/>
    <axis xyz="0 1 0"/>
    <limit effort="5.0" velocity="20.0"/>
    <dynamics damping="0.20" friction="0.20"/>
  </joint>
  <link name="rear_right_wheel_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.000203125" ixy="0" ixz="0"
               iyy="0.000375" iyz="0" izz="0.000203125"/>
    </inertial>
    <visual name="rear_right_wheel_visual">
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.050" length="0.025"/></geometry>
      <material name="wheel_red"/>
    </visual>
    <collision name="rear_right_wheel_collision">
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.050" length="0.025"/></geometry>
    </collision>
  </link>

  <!-- 注册被动脚轮关节，使 JointStateController 能够报告这些关节。 -->
  <transmission name="front_left_caster_swivel_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="front_left_caster_swivel_joint">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="front_left_caster_swivel_actuator">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="front_left_wheel_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="front_left_wheel_joint">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="front_left_wheel_actuator">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="front_right_caster_swivel_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="front_right_caster_swivel_joint">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="front_right_caster_swivel_actuator">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="front_right_wheel_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="front_right_wheel_joint">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="front_right_wheel_actuator">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="rear_left_caster_swivel_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="rear_left_caster_swivel_joint">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="rear_left_caster_swivel_actuator">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="rear_left_wheel_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="rear_left_wheel_joint">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="rear_left_wheel_actuator">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="rear_right_caster_swivel_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="rear_right_caster_swivel_joint">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="rear_right_caster_swivel_actuator">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="rear_right_wheel_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="rear_right_wheel_joint">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="rear_right_wheel_actuator">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <gazebo reference="table_body_link">
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <kp>1000000</kp>
    <kd>10</kd>
    <maxVel>0.1</maxVel>
    <minDepth>0.001</minDepth>
  </gazebo>
  <gazebo reference="front_left_wheel_link">
    <mu1>0.8</mu1><mu2>0.8</mu2><kp>1000000</kp><kd>10</kd>
    <maxVel>0.1</maxVel><minDepth>0.001</minDepth>
  </gazebo>
  <gazebo reference="front_right_wheel_link">
    <mu1>0.8</mu1><mu2>0.8</mu2><kp>1000000</kp><kd>10</kd>
    <maxVel>0.1</maxVel><minDepth>0.001</minDepth>
  </gazebo>
  <gazebo reference="rear_left_wheel_link">
    <mu1>0.8</mu1><mu2>0.8</mu2><kp>1000000</kp><kd>10</kd>
    <maxVel>0.1</maxVel><minDepth>0.001</minDepth>
  </gazebo>
  <gazebo reference="rear_right_wheel_link">
    <mu1>0.8</mu1><mu2>0.8</mu2><kp>1000000</kp><kd>10</kd>
    <maxVel>0.1</maxVel><minDepth>0.001</minDepth>
  </gazebo>
</robot>
