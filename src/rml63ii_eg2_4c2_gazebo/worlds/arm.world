<?xml version="1.0"?>
<sdf version="1.6">
  <world name="arm_world">
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros><update_rate>30.0</update_rate>
    </plugin>
    <gravity>0 0 -9.81</gravity>
    <physics name="arm_ode" type="ode">
      <max_step_size>0.001</max_step_size><real_time_update_rate>1000</real_time_update_rate>
      <real_time_factor>1</real_time_factor>
      <ode><solver><type>quick</type><iters>100</iters><sor>1.3</sor></solver>
        <constraints><cfm>0</cfm><erp>0.2</erp><contact_max_correcting_vel>0.02</contact_max_correcting_vel>
          <contact_surface_layer>0.000001</contact_surface_layer></constraints></ode>
    </physics>
    <scene><ambient>0.65 0.65 0.65 1</ambient><background>0.8 0.84 0.88 1</background><shadows>false</shadows></scene>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular>
      <direction>-0.7 -0.4 -1</direction><cast_shadows>false</cast_shadows>
    </light>
    <model name="ground_plane"><static>true</static><link name="link">
      <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
      <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        <material><ambient>0.55 0.58 0.60 1</ambient><diffuse>0.55 0.58 0.60 1</diffuse></material></visual>
    </link></model>
    <gui fullscreen="0"><camera name="user_camera"><pose>2.2 -2.2 1.8 0 0.25 2.35</pose>
      <view_controller>orbit</view_controller><projection_type>perspective</projection_type>
      <clip><near>0.001</near><far>100</far></clip></camera></gui>
  </world>
</sdf>
