<?xml version="1.0"?>
<robot name="selector_switch" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="prefix" default="xuanniu_"/><xacro:arg name="robot_namespace" default="/xuanniu"/>
  <xacro:arg name="world_fixed" default="true"/><xacro:arg name="enable_plugin" default="true"/>
  <xacro:arg name="mount_xyz" default="0 0 .12"/><xacro:arg name="mount_rpy" default="0 0 0"/>
  <xacro:include filename="$(find xuanniu_gazebo)/urdf/xuanniu_macro.xacro"/>
  <link name="$(arg prefix)mount_link"><inertial><mass value=".001"/><inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/></inertial></link>
  <xacro:if value="$(arg world_fixed)"><link name="world"/><joint name="$(arg prefix)world_joint" type="fixed"><parent link="world"/><child link="$(arg prefix)mount_link"/><origin xyz="$(arg mount_xyz)" rpy="$(arg mount_rpy)"/></joint></xacro:if>
  <xacro:selector_switch parent="$(arg prefix)mount_link" prefix="$(arg prefix)" robot_namespace="$(arg robot_namespace)" enable_plugin="$(arg enable_plugin)"><origin xyz="0 0 0"/></xacro:selector_switch>
</robot>
