<?xml version='1.0' encoding='utf-8'?>
<package format="3">
  <name>fugui_gazebo</name>
  <version>0.2.0</version>
  <description>Dimensioned protection signal reset pushbutton with Gazebo URDF, MuJoCo MJCF and control GUIs.</description>
  <maintainer email="181957883+Lancerman2001@users.noreply.github.com">Lancerman2001</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>gazebo_ros</depend>
  <depend>gazebo_plugins</depend>
  <depend>gazebo_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>robot_state_publisher</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>ament_index_python</depend>
  <depend>cabinet_sim_support</depend>
  <exec_depend>python3-tk</exec_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>
  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros plugin_path="${prefix}/../../lib" />
  </export>
  <build_depend>gazebo_dev</build_depend>
</package>