<?xml version="1.0"?>
<robot name="yaban" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="world_fixed" default="true"/>
  <xacro:arg name="enable_plugin" default="true"/>
  <xacro:arg name="demo_control" default="false"/>
  <xacro:arg name="prefix" default="yaban_"/>
  <xacro:arg name="robot_namespace" default="/yaban"/>
  <xacro:arg name="mount_xyz" default="0 0 0.08"/>
  <xacro:arg name="mount_rpy" default="0 0 0"/>
  <xacro:include filename="$(find yaban_gazebo)/urdf/yaban_macro.xacro"/>
  <link name="$(arg prefix)mount_link"/>
  <xacro:if value="$(arg world_fixed)">
    <link name="world"/>
    <joint name="$(arg prefix)world_mount" type="fixed"><parent link="world"/><child link="$(arg prefix)mount_link"/>
      <origin xyz="$(arg mount_xyz)" rpy="$(arg mount_rpy)"/>
    </joint>
  </xacro:if>
  <xacro:yaban parent="$(arg prefix)mount_link" prefix="$(arg prefix)" robot_namespace="$(arg robot_namespace)"
     enable_plugin="$(arg enable_plugin)" demo_control="$(arg demo_control)">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:yaban>
</robot>
