<?xml version="1.0"?>
<sdf version="1.6"><world name="default">
  <physics name="small_parts" type="ode">
    <max_step_size>0.001</max_step_size><real_time_update_rate>1000</real_time_update_rate>
    <ode><solver><type>quick</type><iters>100</iters></solver>
