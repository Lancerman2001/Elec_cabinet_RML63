  <model name="ground"><static>true</static><link name="ground"><collision name="ground"><geometry><plane><normal>0 0 1</normal><size>1 1</size></plane></geometry></collision><visual name="ground"><geometry><plane><normal>0 0 1</normal><size>1 1</size></plane></geometry><material><ambient>0.35 0.37 0.40 1</ambient><diffuse>0.35 0.37 0.40 1</diffuse></material></visual></link></model>
